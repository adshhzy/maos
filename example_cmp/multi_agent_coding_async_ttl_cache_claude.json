        "poll_seconds": 30,
        "timeout_seconds": 2400,
        "artifact_transfer_mode": "inline",
        "result_text_limit": 14000,
        "prompt_payload_limit": 30000,
        "bare": true,
        "prompt": "你是 Python 测试工程师。请严格基于上游架构规格，输出 pytest 风格测试代码。测试至少覆盖：cache hit/miss、TTL 过期、LRU 淘汰、invalidate/clear、异常不缓存、异步并发 single-flight 只执行一次、同步函数装饰器、异步函数装饰器、cache_info 统计。可以使用 pytest.mark.asyncio，但被测库本身不得依赖第三方。请输出完整测试文件代码。"
      },
      "timeout_seconds": 2700
