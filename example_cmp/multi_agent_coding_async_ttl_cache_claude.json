        "concurrency_reviewer"
      ],
      "agent": {
        "backend": "claude",
        "agent_key": "coordinator",
        "context_policy": "provided_context_only",
        "runtime_profile": "claude_print",
        "execution_mode": "claude_print",
        "poll_seconds": 30,
        "timeout_seconds": 3600,
        "artifact_transfer_mode": "inline",
        "result_text_limit": 26000,
        "prompt_payload_limit": 70000,
        "bare": true,
        "prompt": "你是最终整合工程师。请基于所有上游结果，产出最终可交付版本：1) `maos_cache.py` 完整最终主体代码；2) 简短设计说明；3) 最小可运行使用示例；4) 说明你如何吸收审查意见。不要生成 pytest、unittest 或任何测试文件代码。必须修复上游审查指出的问题。代码块必须完整可复制，不要省略。"
      },
      "timeout_seconds": 3900
