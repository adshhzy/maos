{
  "id": "multi-agent-coding-async-ttl-cache-claude",
  "name": "多 Claude 协作编码示例 - AsyncTTLCache 小库实现",
  "graph_type": "dag",
  "default_join": "all",
  "input": {
    "task": "请实现一个可复用的 Python 小库 `maos_cache.py`，提供一个生产可用的 `AsyncTTLCache` 与装饰器能力。要求：1. 支持同步函数和异步函数的缓存装饰器；2. 支持 TTL 过期、maxsize LRU 淘汰、手动 clear/invalidate；3. 对同一个 key 的并发异步调用要做 single-flight 去重，避免重复执行底层函数；4. 异常结果不能被缓存；5. 提供 cache_info 统计：hits、misses、evictions、inflight、size；6. 使用标准库实现，不依赖第三方库；7. 给出完整代码、pytest 风格测试代码、关键设计说明和使用示例。"
  },
  "nodes": [
    {
      "id": "requirements_architect",
      "label": "需求澄清与接口设计",
      "operation": "agent_task",
      "agent": {
        "backend": "claude",
        "agent_key": "architect",
        "context_policy": "provided_context_only",
        "runtime_profile": "claude_print",
        "execution_mode": "claude_print",
        "poll_seconds": 30,
        "timeout_seconds": 1800,
        "artifact_transfer_mode": "inline",
        "result_text_limit": 9000,
        "prompt_payload_limit": 22000,
        "bare": true,
        "prompt": "你是 Python 库架构师。请把原始编码任务拆成明确规格，输出结构化 Markdown：公共 API、类/函数签名、关键数据结构、TTL 与 LRU 的交互规则、同步/异步装饰器行为、并发 single-flight 语义、异常处理、cache_info 统计定义、测试验收清单。不要写完整实现代码，但可以给出伪代码。"
      },
      "timeout_seconds": 2100
    },
    {
      "id": "core_implementation",
      "label": "核心实现编码",
      "operation": "agent_task",
      "deps": [
        "requirements_architect"
