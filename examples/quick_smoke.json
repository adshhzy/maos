{
  "id": "quick-smoke",
  "name": "Quick smoke test",
  "input": {
    "message": "MAOS quick smoke"
  },
  "nodes": [
    {
      "id": "start",
      "label": "Start",
      "operation": "emit",
      "params": {
        "message": "$input.message"
      },
      "simulate": {
        "min_seconds": 0.1,
        "max_seconds": 0.2
      }
    },
    {
      "id": "finish",
      "label": "Finish",
      "operation": "join",
      "deps": ["start"],
      "params": {
        "fields": {
          "status": "ok",
          "message": "$deps.start.message"
        }
      },
      "simulate": {
        "min_seconds": 0.1,
        "max_seconds": 0.2
      }
    }
  ]
}
